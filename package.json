{
  "name": "subletsafe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:db": "vitest run tests/database.test.ts",
    "format": "prettier --write src tests supabase/functions *.ts *.json *.js"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router": "^7.9.0",
    "@supabase/supabase-js": "^2.80.0",
    "lucide-react": "^0.468.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.2.0",
    "typescript": "~5.9.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/node": "^24.0.0",
    "vitest": "^3.2.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.39.0",
    "typescript-eslint": "^8.46.0",
    "@eslint/js": "^9.39.0",
    "globals": "^16.5.0",
    "@electric-sql/pglite": "^0.3.14",
    "tailwindcss": "^4.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "imagescript": "3.3.0",
    "prettier": "^3.6.0",
    "jsdom": "^27.0.0"
  },
  "packageManager": "pnpm@11.25.0"
}
